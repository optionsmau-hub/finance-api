# Copia este archivo a .env y ajusta los valores.
# cp .env.example .env   (o copialo desde el explorador de archivos)

# --- Base de datos ---
# Opcion A: SQLite, sin instalar nada (ideal para empezar hoy)
DATABASE_URL=sqlite:///./finance.db

# Opcion B: PostgreSQL (produccion / mas realista). Descomenta y ajusta:
# DATABASE_URL=postgresql+psycopg://finance:finance@localhost:5432/finance_db

# --- App ---
APP_NAME=Finance API
DEBUG=true
